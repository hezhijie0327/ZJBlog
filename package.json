{
  "name": "hezhijie-blog",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --ssr tools/ssr.tsx && node scripts/prerender.mjs",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "tsc": "tsc --noEmit",
    "audit": "node scripts/audit.mjs",
    "linkcheck": "node scripts/linkcheck.mjs",
    "ci": "pnpm run lint && pnpm run tsc && pnpm run build",
    "clean": "rm -rf dist .vite-ssr node_modules"
  },
  "browserslist": [
    "baseline 2022",
    "not dead"
  ],
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.45.0",
    "mermaid": "^11.14.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "browserslist": "^4.28.8",
    "browserslist-to-esbuild": "^2.1.1",
    "chrome-launcher": "^1.2.1",
    "gray-matter": "^4.0.3",
    "lighthouse": "^13.5.0",
    "reading-time": "^1.5.0",
    "rehype-external-links": "^3.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "shiki": "^4.4.3",
    "tailwindcss": "^4.2.2",
    "typescript": "~5.9.3",
    "unified": "^11.0.5",
    "vite": "^8.2.2"
  }
}
