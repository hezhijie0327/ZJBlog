{
  "name": "hezhijie-blog",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --ssr tools/ssr.tsx && node scripts/prerender.mjs",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "tsc": "tsc --noEmit",
    "audit": "node scripts/audit.mjs",
    "linkcheck": "node scripts/linkcheck.mjs",
    "ci": "pnpm run lint && pnpm run tsc && pnpm run build",
    "clean": "rm -rf dist .vite-ssr node_modules"
  },
  "browserslist": [
    "baseline 2022",
    "not dead"
  ],
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.47.0",
    "mermaid": "^12.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "browserslist": "^4.29.0",
    "browserslist-to-esbuild": "^2.1.1",
    "chrome-launcher": "^1.2.1",
    "gray-matter": "^4.0.3",
    "lighthouse": "^13.5.0",
    "reading-time": "^1.5.0",
    "rehype-external-links": "^3.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "shiki": "^4.4.3",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "unified": "^11.0.5",
    "vite": "^8.3.0"
  },
  "packageManager": "pnpm@12.5.1"
}
