# Response headers for Cloudflare Workers Static Assets (lands at the dist/
# root at build time, copied from public/ by Vite). The giscus iframe loads
# the self-hosted theme CSS via <link crossorigin="anonymous"> from another
# origin (giscus.app), so ACAO must be served back or the browser blocks the
# stylesheet and the comment section degrades to unstyled. The dev side serves
# the same header via vite.config server.cors. The file content is a public
# color palette — a wildcard allow is fine.
#
# Plain-text endpoints need an explicit charset=utf-8: Workers static assets
# serve .txt as bare text/plain, and without a charset Chrome guesses the
# encoding from the system locale (GBK on Chinese systems), turning every
# non-ASCII character in llms.txt into mojibake. _headers values override the
# defaults; llms*.txt has no in-file way to declare an encoding (unlike XML's
# encoding=), and robots.txt declares it explicitly for the same reason.

/giscus-light.css
  Access-Control-Allow-Origin: *

/giscus-dark.css
  Access-Control-Allow-Origin: *

/llms.txt
  Content-Type: text/plain; charset=utf-8

/llms-full.txt
  Content-Type: text/plain; charset=utf-8

/robots.txt
  Content-Type: text/plain; charset=utf-8

# Exported original Markdown (the source of the post page's "copy as
# Markdown" button + direct links for agents): same as above, no in-file
# encoding declaration, so an explicit charset prevents mojibake on direct
# opens. One splat covers /<kind>/<slug>/index.md for all three detail pages.
/blogs/*/index.md
  Content-Type: text/markdown; charset=utf-8

/travels/*/index.md
  Content-Type: text/markdown; charset=utf-8

/projects/*/index.md
  Content-Type: text/markdown; charset=utf-8

# PWA install layer (DESIGN.md §18): the worker itself must not be cached —
# updates then take effect on the next load instead of riding the CDN's long
# cache; declares the scope root (the default max scope for /sw.js is already
# /, this header is the explicit record; the audit gate verifies against it).
/sw.js
  Cache-Control: no-cache
  Service-Worker-Allowed: /
