{
  "name": "blog",
  // Track the newest compatibility date supported by the repo's pinned
  // wrangler (bump it forward when upgrading wrangler; a pure static-assets
  // Worker consumes no runtime semantics, so the risk is near zero).
  "compatibility_date": "2026-09-30",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  // Runtime Cache (same switch as dashboard Settings → Runtime → Cache):
  // edge nodes cache Worker responses. Cross-version reuse
  // (cross_version_cache) stays off by default — caches are isolated per
  // Worker version and every deploy swaps them wholesale, so there is no
  // window where a deploy serves stale content; enabling it would carry
  // cached assets into the new version for colder starts (with a staleness
  // risk for same-path HTML). The _headers no-cache edge for /sw.js is
  // honored here too.
  "cache": {
    "enabled": true
  },
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  }
}
